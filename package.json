{
  "name": "@monabbous/slidebox",
  "version": "1.3.2",
  "description": "Elastic, system-color-aware CSS checkbox switch.",
  "license": "ISC",
  "style": "./dist/css/slidebox.css",
  "sass": "./scss/slidebox.scss",
  "less": "./less/slidebox.less",
  "files": [
    "dist/css/slidebox.css",
    "dist/css/group.css",
    "scss/",
    "less/",
    "tailwind/",
    "experimental/",
    "skills/slidebox/",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0 <5"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monabbous/slidebox.git"
  },
  "homepage": "https://nabous.dev/lab/slidebox/",
  "bugs": {
    "url": "https://github.com/monabbous/slidebox/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-public.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "benchmark": "node benchmarks/run.mjs",
    "benchmark:report": "node benchmarks/report.mjs",
    "benchmark:serve": "node benchmarks/serve.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "slidebox",
    "switch",
    "toggle",
    "checkbox",
    "css",
    "scss",
    "elastic",
    "system-colors"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "^4.3.3",
    "less": "^4.9.1",
    "postcss": "^8.5.32",
    "sass": "^1.107.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-v4": "npm:tailwindcss@^4.3.3"
  }
}
